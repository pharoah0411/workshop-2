<?php
require_once 'db_connect.php';

// ====================== SUMMARY CARDS ======================
$totalUsers = $conn->query("SELECT COUNT(*) AS total FROM users")->fetch_assoc()['total'];
$totalPatients = $conn->query("SELECT COUNT(*) AS total FROM patient")->fetch_assoc()['total'];
$totalPrescriptions = $conn->query("SELECT COUNT(*) AS total FROM prescription")->fetch_assoc()['total'];
$lowStock = $conn->query("SELECT COUNT(*) AS total FROM medicine WHERE quantity_in_stock < 20")->fetch_assoc()['total'];

$todaysSales = $conn->query("
    SELECT IFNULL(SUM(total_amount), 0) AS total 
    FROM payment 
    WHERE payment_date = CURDATE()
")->fetch_assoc()['total'];

$monthlySales = $conn->query("
    SELECT IFNULL(SUM(total_amount), 0) AS total 
    FROM payment 
    WHERE MONTH(payment_date) = MONTH(CURDATE())
    AND YEAR(payment_date) = YEAR(CURDATE())
")->fetch_assoc()['total'];


// ====================== SALES CHART (DAILY SALES) ======================
$salesData = $conn->query("
    SELECT DAY(payment_date) AS day, SUM(total_amount) AS total
    FROM payment
    WHERE MONTH(payment_date) = MONTH(CURDATE())
    GROUP BY DAY(payment_date)
    ORDER BY day
");

$salesDays = [];
$salesTotals = [];

while ($row = $salesData->fetch_assoc()) {
    $salesDays[] = $row['day'];
    $salesTotals[] = $row['total'];
}



// ====================== TOP 5 MEDICINES CHART ======================
$topMed = $conn->query("
    SELECT m.name, COUNT(pd.medicine_id) AS times_prescribed
    FROM prescription_detail pd
    JOIN medicine m ON pd.medicine_id = m.medicine_id
    GROUP BY pd.medicine_id
    ORDER BY times_prescribed DESC
    LIMIT 5
");

$medNames = [];
$medCounts = [];

while ($row = $topMed->fetch_assoc()) {
    $medNames[] = $row['name'];
    $medCounts[] = $row['times_prescribed'];
}


// ====================== STOCK PIE CHART ======================
$stockData = $conn->query("
    SELECT name, quantity_in_stock
    FROM medicine
    ORDER BY quantity_in_stock ASC 
    LIMIT 5
");

$stockNames = [];
$stockQty = [];

while ($row = $stockData->fetch_assoc()) {
    $stockNames[] = $row['name'];
    $stockQty[] = $row['quantity_in_stock'];
}

$conn->close();
?>

